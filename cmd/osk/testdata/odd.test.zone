; Records in odd but legal shapes. TestQueryMatchesDig loads this zone on a
; lab server and compares osk query with dig for every name and type in it.
; Only types that osk reads as typed data appear, plus one private type, so
; that dig and osk print every record in the same form.
$ORIGIN odd.test.
$TTL 300
@               SOA     ns1 hostmaster 1 3600 600 604800 300
@               NS      ns1
ns1             A       192.0.2.53

; Owner names whose printed form needs escapes, and one in mixed case.
weird\032name   A       192.0.2.1
a\.b            A       192.0.2.2
x\@y\$z\;w\(\)\"q A     192.0.2.3
\000\255        A       192.0.2.4
MiXeD.CaSe      A       192.0.2.5
; The longest legal name: 255 octets in wire form.
aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb.ccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc.dddddddddddddddddddddddddddddddddddddddddddddddddddd A 192.0.2.6
; A known type in the generic form of RFC 3597 still prints as an address.
generic         A       \# 4 C0000207

; Addresses whose shortest text form is easy to get wrong.
v6              AAAA    ::1.2.3.4
v6              AAAA    ::FFFF:1.2.3.4
v6              AAAA    1:0:0:2:0:0:3:4
v6              AAAA    1:0:0:1:0:0:0:1
v6              AAAA    0:0:0:0:0:0:0:0
v6              AAAA    1:2:3:4:5:6:0:8

txt             TXT     "a\"b\\c" "semi;colon" "tab\009x" "\255\128" ""
long            TXT     "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx" "yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy"
; A DKIM key of 2048 bits does not fit in one string of 255 octets.
dkim._domainkey TXT     "v=DKIM1; k=rsa; p=MIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEAABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/A" "BCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/ABCDEFGHIJKLMNOPQRSTUVIDAQAB"

; Too large for one UDP answer of 1232 octets, so the answer comes over TCP.
many            TXT     "record 01 of 80 in one set"
many            TXT     "record 02 of 80 in one set"
many            TXT     "record 03 of 80 in one set"
many            TXT     "record 04 of 80 in one set"
many            TXT     "record 05 of 80 in one set"
many            TXT     "record 06 of 80 in one set"
many            TXT     "record 07 of 80 in one set"
many            TXT     "record 08 of 80 in one set"
many            TXT     "record 09 of 80 in one set"
many            TXT     "record 10 of 80 in one set"
many            TXT     "record 11 of 80 in one set"
many            TXT     "record 12 of 80 in one set"
many            TXT     "record 13 of 80 in one set"
many            TXT     "record 14 of 80 in one set"
