caa             CAA     128 issue "ca.example; account=42"
caa             CAA     0 iodef "mailto:security@odd.test"
caa             CAA     0 futureTag9 "a\"b\\c\009\255"

; A mail exchanger at the root says that the domain takes no mail.
mx              MX      0 .
alias           CNAME   target
target          A       192.0.2.9
dn              DNAME   example.net.
ptr             PTR     Target.odd.test.
; SPF has the form of TXT.
spf             SPF     "v=spf1 -all" ""

; DNSSEC types as plain data, outside the apex, so the zone stays unsigned.
; The key and the signature are the examples of RFC 4034.
ds              DS      60485 5 1 2BB183AF5F22588179A53B0A98631FAD1A292118
key             DNSKEY  256 3 5 AQPSKmynfzW4kyBv015MUG2DeIQ3Cbl+BBZH4b/0PY1kxkmvHjcZc8nokfzj31GajIQKY+5CptLr3buXA10hWqTkF7H6RfoRqXQeogmMHfpftf6zMv1LyBUgia7za6ZEzOJBOztyvhjL742iU/TpPSEDhm2SNKLijfUppn1UaNvv4w==
sig             RRSIG   A 5 3 86400 20300101000000 20261101000000 2642 odd.test. oJB1W6WNGv+ldvQ3WDG0MQkg5IEhjRip8WTrPYGv07h108dUKGMeDPKijVCHX3DDKdfb+v6oB9wfuh3DTJXUAfI/M0zmO/zz8bW0Rznl8O3tGNazPwQKkRN20XPXV6nwwfoXmJQbsLNrLfkGJ5D6fwFm8nN+6pBzeDQfsS3Ap3o=
; Type 128 (NXNAME) and a private type have no mnemonic.
nsec            NSEC    next.odd.test. A RRSIG NSEC TYPE128 TYPE65280
n3p             NSEC3PARAM 1 0 0 -
n3p             NSEC3PARAM 1 0 10 ABCD

; A private type, with data and without.
unk             TYPE65280 \# 4 0A000001
unk0            TYPE65280 \# 0
